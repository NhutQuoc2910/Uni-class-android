<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_lecturer"
    app:startDestination="@id/nav_lecturer_home">

    <fragment
        android:id="@+id/nav_lecturer_home"
        android:name="com.ppquang06.uniclassapp.ui.lecturer.home.LecturerHomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_lecturer_home" />

    <fragment
        android:id="@+id/nav_lecturer_classes"
        android:name="com.ppquang06.uniclassapp.ui.lecturer.classes.LecturerClassesFragment"
        android:label="@string/nav_classes"
        tools:layout="@layout/fragment_lecturer_classes" />

    <fragment
        android:id="@+id/nav_lecturer_notifications"
        android:name="com.ppquang06.uniclassapp.ui.lecturer.notifications.LecturerNotificationsFragment"
        android:label="@string/nav_notifications"
        tools:layout="@layout/fragment_lecturer_notifications" />

    <fragment
        android:id="@+id/nav_lecturer_profile"
        android:name="com.ppquang06.uniclassapp.ui.lecturer.profile.LecturerProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_lecturer_profile" />

    <!-- Phase 4 Lecturer Flows -->
    <fragment
        android:id="@+id/nav_lecturer_create_class"
        android:name="com.ppquang06.uniclassapp.ui.lecturer.classes.LecturerCreateClassFragment"
        android:label="@string/create_class_title"
        tools:layout="@layout/fragment_lecturer_create_class" />

    <fragment
        android:id="@+id/nav_lecturer_class_invite"
        android:name="com.ppquang06.uniclassapp.ui.lecturer.classes.LecturerClassInviteFragment"
        android:label="@string/create_class_success_title"
        tools:layout="@layout/fragment_lecturer_class_invite">
        <argument
            android:name="classId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="classCode"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="className"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="inviteCode"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/nav_lecturer_class_detail"
        android:name="com.ppquang06.uniclassapp.ui.lecturer.classes.LecturerClassDetailFragment"
        android:label="@string/nav_classes">
        <argument
            android:name="classId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="classCode"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="className"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="semester"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="inviteCode"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="status"
            app:argType="string"
            android:defaultValue="ACTIVE" />
    </fragment>

    <fragment
        android:id="@+id/nav_lecturer_qr_session"
        android:name="com.ppquang06.uniclassapp.ui.lecturer.attendance.LecturerQrSessionFragment"
        android:label="@string/qr_session_title">
        <argument
            android:name="classId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="classCode"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="className"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="room"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/nav_lecturer_attendance_live"
        android:name="com.ppquang06.uniclassapp.ui.lecturer.attendance.LecturerAttendanceLiveFragment"
        android:label="@string/attendance_live_title">
        <argument
            android:name="sessionId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="classId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="classCode"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="className"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="room"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/nav_lecturer_members"
        android:name="com.ppquang06.uniclassapp.ui.lecturer.classes.LecturerMembersFragment"
        android:label="@string/lecturer_members_title"
        tools:layout="@layout/fragment_lecturer_members">
        <argument
            android:name="classId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="classCode"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="className"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="enrolledCount"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>

    <fragment
        android:id="@+id/nav_lecturer_member_profile"
        android:name="com.ppquang06.uniclassapp.ui.lecturer.classes.LecturerMemberProfileFragment"
        android:label="@string/lecturer_profile_title"
        tools:layout="@layout/fragment_lecturer_member_profile">
        <argument
            android:name="classId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="studentId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="memberJson"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/nav_lecturer_create_assignment"
        android:name="com.ppquang06.uniclassapp.ui.lecturer.assignments.LecturerCreateAssignmentFragment"
        android:label="@string/section_assignments">
        <argument
            android:name="classId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="classCode"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="className"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/nav_lecturer_assignment_submissions"
        android:name="com.ppquang06.uniclassapp.ui.lecturer.assignments.LecturerAssignmentSubmissionsFragment"
        android:label="@string/assignment_submissions_title">
        <argument
            android:name="assignmentId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="assignmentTitle"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="classCode"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="dueDate"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/nav_lecturer_grading"
        android:name="com.ppquang06.uniclassapp.ui.lecturer.assignments.LecturerGradingFragment"
        android:label="@string/grading_title">
        <argument
            android:name="assignmentId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="assignmentTitle"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="studentId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="studentName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="submissionsJson"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="initialIndex"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>

    <fragment
        android:id="@+id/nav_lecturer_class_statistics"
        android:name="com.ppquang06.uniclassapp.ui.lecturer.classes.LecturerClassStatisticsFragment"
        android:label="@string/lecturer_action_stats">
        <argument
            android:name="classId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="classCode"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="className"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="semester"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

</navigation>
