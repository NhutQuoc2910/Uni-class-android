<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <include
        android:id="@+id/topAppBar"
        layout="@layout/view_top_app_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingVertical="@dimen/space_16">

            <TextView
                android:id="@+id/tvTodayDate"
                style="@style/TextAppearance.EduLens.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/today_date"
                android:textColor="@color/text_muted"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGreetingUser"
                style="@style/TextAppearance.EduLens.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/greeting_user" />

            <TextView
                android:id="@+id/tvGreetingSub"
                style="@style/TextAppearance.EduLens.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/greeting_sub" />

            <!-- Metrics Row (3 cards: metricCourses, metricAttendance, metricPending) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal"
                android:weightSum="3">

                <include
                    android:id="@+id/metricCourses"
                    layout="@layout/view_attendance_metric"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_8"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/metricAttendance"
                    layout="@layout/view_attendance_metric"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_8"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/metricPending"
                    layout="@layout/view_attendance_metric"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Classes Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.EduLens.Subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/my_classes_title" />

                <TextView
                    style="@style/TextAppearance.EduLens.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/see_all"
                    android:textColor="@color/color_primary"
                    android:textStyle="bold" />
            </LinearLayout>

            <include
                android:id="@+id/sampleCourseCard"
                layout="@layout/item_course_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
