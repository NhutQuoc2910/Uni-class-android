<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uc_bg_canvas"
    android:orientation="vertical">

    <!-- Top Bar with Flash Toggle -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/uc_bg_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/scan_qr_screen_title"
            android:textColor="@color/uc_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Flash Toggle Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFlash"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Bật/Tắt Flash"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/uc_surface_elevated"
            app:icon="@drawable/ic_flash"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/uc_text_primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Viewfinder Area (240x240dp) -->
            <FrameLayout
                android:id="@+id/frameViewfinder"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_qr_frame">

                <!-- Real CameraX Live Preview -->
                <androidx.camera.view.PreviewView
                    android:id="@+id/previewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Center QR Placeholder Icon -->
                <ImageView
                    android:id="@+id/ivQrCenter"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:alpha="0.3"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_qr_code"
                    app:tint="@color/p2_lavender" />

                <!-- Scanning Line -->
                <View
                    android:id="@+id/viewScanLine"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@drawable/bg_qr_scanner_line" />
            </FrameLayout>

            <!-- Instructions -->
            <TextView
                android:id="@+id/tvInstructionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/scan_qr_viewfinder_instruction"
                android:textColor="@color/uc_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInstructionSub"
                style="@style/TextAppearance.EduLens.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/scan_qr_viewfinder_subinstruction"
                android:textColor="@color/uc_text_secondary" />

            <!-- Before Scanning Section -->
            <TextView
                style="@style/TextAppearance.EduLens.Badge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.04"
                android:text="@string/scan_qr_before_title"
                android:textColor="@color/uc_text_secondary" />

            <!-- Requirement 1: WiFi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_unified_surface_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_wifi"
                    app:tint="@color/p2_teal" />

                <TextView
                    style="@style/TextAppearance.EduLens.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/scan_qr_req_wifi"
                    android:textColor="@color/uc_text_primary"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/color_success" />
            </LinearLayout>

            <!-- Requirement 2: GPS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_unified_surface_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_gps"
                    app:tint="@color/p2_teal" />

                <TextView
                    style="@style/TextAppearance.EduLens.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/scan_qr_req_gps"
                    android:textColor="@color/uc_text_primary"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/color_success" />
            </LinearLayout>

            <!-- Requirement 3: Device -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_unified_surface_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_smartphone"
                    app:tint="@color/p2_teal" />

                <TextView
                    style="@style/TextAppearance.EduLens.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/scan_qr_req_device"
                    android:textColor="@color/uc_text_primary"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/color_success" />
            </LinearLayout>

            <!-- Action Buttons for Quick Demo & Error Simulations -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadQrImage"
                style="@style/Widget.EduLens.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:strokeColor="@color/uc_border_card"
                android:text="Tải ảnh QR từ máy để quét"
                android:textColor="@color/uc_text_primary"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_download"
                app:iconGravity="textStart"
                app:iconTint="@color/p2_teal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickScan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/p2_teal"
                android:text="@string/scan_qr_btn_quick"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_qr_scan"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimulateErrors"
                style="@style/Widget.EduLens.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:strokeColor="@color/uc_border_card"
                android:text="@string/scan_qr_btn_simulate"
                android:textColor="@color/uc_text_secondary"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_chevron_right"
                app:iconGravity="textEnd"
                app:iconTint="@color/uc_text_secondary" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
