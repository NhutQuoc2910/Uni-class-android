<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardWeeklyCell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="2dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/uc_surface_elevated"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/uc_border_card"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/tvCellBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_badge_pill"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Lịch bù"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvCellClassCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/color_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="SS007.R15" />

        <TextView
            android:id="@+id/tvCellClassName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="3"
            android:textColor="@color/uc_text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Triết học Mác – Lênin" />

        <TextView
            android:id="@+id/tvCellPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/uc_text_secondary"
            android:textSize="10sp"
            tools:text="Tiết 1–3 (07:30-09:45)" />

        <TextView
            android:id="@+id/tvCellRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/uc_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="Phòng B5.14" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
