<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nordic_canvas_light"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".ForgotPassNewActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/desc_back_button"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/nordic_obsidian_navy" />

                <TextView
                    android:id="@+id/tvStepTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Thiết lập mật khẩu mới"
                    android:textColor="@color/nordic_midnight_slate"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStepBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_nordic_prompt_card"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/nordic_forgot_step3_badge"
                    android:textColor="@color/nordic_midnight_slate"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- 3-Segment Progress Bar (All 3 segments active) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_nordic_segment_active" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_nordic_segment_active" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_nordic_segment_active" />
            </LinearLayout>
        </LinearLayout>

        <!-- Main Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- Verified OTP Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_nordic_feature_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/nordic_forgot_step3_badge_verified"
                android:textColor="@color/nordic_midnight_slate"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/nordic_forgot_step3_title"
                android:textColor="@color/nordic_obsidian_navy"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/nordic_forgot_step3_subtitle"
                android:textColor="@color/nordic_muted_steel"
                android:textSize="12sp" />

            <!-- New Password Input -->
            <LinearLayout
                android:id="@+id/containerNewPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_nordic_input_selector"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/nordic_muted_steel" />

                <EditText
                    android:id="@+id/edtNewPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:autofillHints="newPassword"
                    android:background="@null"
                    android:hint="@string/new_password_hint"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/nordic_obsidian_navy"
                    android:textColorHint="@color/nordic_muted_steel"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivToggleNewPassword"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:clickable="true"
                    android:contentDescription="@null"
                    android:focusable="true"
                    android:padding="2dp"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/nordic_muted_steel" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvErrorNewPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:textColor="@color/nordic_error_rose"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Confirm Password Input -->
            <LinearLayout
                android:id="@+id/containerConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_nordic_input_selector"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/nordic_muted_steel" />

                <EditText
                    android:id="@+id/edtConfirmPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:autofillHints="newPassword"
                    android:background="@null"
                    android:hint="@string/confirm_new_password_hint"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/nordic_obsidian_navy"
                    android:textColorHint="@color/nordic_muted_steel"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivToggleConfirmPassword"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:clickable="true"
                    android:contentDescription="@null"
                    android:focusable="true"
                    android:padding="2dp"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/nordic_muted_steel" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvErrorConfirmPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:textColor="@color/nordic_error_rose"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Live Security Requirements Card -->
            <LinearLayout
                android:id="@+id/layoutSecurityCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_nordic_surface_btn"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nordic_security_title"
                    android:textColor="@color/nordic_muted_steel"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Chips Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipRuleMinLength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_nordic_chip_security_idle"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="○ Từ 8 ký tự"
                        android:textColor="@color/nordic_muted_steel"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipRuleUppercase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_nordic_chip_security_idle"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="○ Chữ in hoa"
                        android:textColor="@color/nordic_muted_steel"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipRuleLowercase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_nordic_chip_security_idle"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="○ Chữ thường"
                        android:textColor="@color/nordic_muted_steel"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Chips Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipRuleDigit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_nordic_chip_security_idle"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="○ Chữ số (0-9)"
                        android:textColor="@color/nordic_muted_steel"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipRuleSpecial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_nordic_chip_security_idle"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="○ Ký tự đặc biệt"
                        android:textColor="@color/nordic_muted_steel"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp">

                <LinearLayout
                    android:id="@+id/btnResetPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_nordic_primary_cta"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvBtnResetLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nordic_forgot_step3_cta"
                        android:textColor="@color/nordic_frosted_silver"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivBtnResetArrow"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/nordic_frosted_silver" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/nordic_frosted_silver"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
