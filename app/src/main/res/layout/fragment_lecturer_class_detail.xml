<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <include
        android:id="@+id/topAppBar"
        layout="@layout/view_top_app_bar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <!-- Header Card (Figma 74:1143) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_surface_card"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <TextView
                            android:id="@+id/tvClassName"
                            style="@style/TextAppearance.EduLens.Headline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/text_primary"
                            tools:text="Thiết kế giao diện người dùng" />

                        <TextView
                            android:id="@+id/tvClassCodeSemester"
                            style="@style/TextAppearance.EduLens.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:textColor="@color/text_secondary"
                            tools:text="NT118.O21 · HK1 (2026-2027)" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvClassRoom"
                                style="@style/TextAppearance.EduLens.Caption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/text_muted"
                                tools:text="Phòng B5.12" />

                            <!-- Pill for Invite Code -->
                            <LinearLayout
                                android:id="@+id/btnCopyInviteCode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_pill"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="@dimen/space_12"
                                android:paddingVertical="@dimen/space_4">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_content_copy"
                                    app:tint="@color/color_primary" />

                                <TextView
                                    android:id="@+id/tvInviteCode"
                                    style="@style/TextAppearance.EduLens.Badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_4"
                                    android:textColor="@color/color_primary"
                                    tools:text="Mã: K7M-2QX" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 3 Metric Cards Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- Metric 1: Students -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_4"
                            android:layout_weight="1"
                            android:background="@drawable/bg_surface_card"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/space_12">

                            <TextView
                                android:id="@+id/tvEnrolledCount"
                                style="@style/TextAppearance.EduLens.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/color_primary"
                                tools:text="45" />

                            <TextView
                                style="@style/TextAppearance.EduLens.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/metric_students"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <!-- Metric 2: Assignments -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/space_4"
                            android:layout_weight="1"
                            android:background="@drawable/bg_surface_card"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/space_12">

                            <TextView
                                android:id="@+id/tvAssignmentCount"
                                style="@style/TextAppearance.EduLens.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/color_primary"
                                tools:text="4" />

                            <TextView
                                style="@style/TextAppearance.EduLens.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/metric_assignments"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <!-- Metric 3: Attendance -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:background="@drawable/bg_surface_card"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/space_12">

                            <TextView
                                android:id="@+id/tvAttendanceRate"
                                style="@style/TextAppearance.EduLens.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/color_primary"
                                tools:text="92%" />

                            <TextView
                                style="@style/TextAppearance.EduLens.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/metric_attendance"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Quick Action Buttons Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:orientation="horizontal">

                        <!-- Manage Members -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManageMembers"
                            style="@style/Widget.EduLens.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height_md"
                            android:layout_marginEnd="@dimen/space_4"
                            android:layout_weight="1"
                            android:paddingHorizontal="@dimen/space_4"
                            android:text="@string/lecturer_action_members"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_group"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/space_4"
                            app:iconSize="16dp"
                            app:iconTint="@color/color_primary" />

                        <!-- Open QR Session -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenQrSession"
                            style="@style/Widget.EduLens.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height_md"
                            android:layout_marginHorizontal="@dimen/space_4"
                            android:layout_weight="1.2"
                            android:paddingHorizontal="@dimen/space_4"
                            android:text="@string/lecturer_action_qr"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_qr_scan"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/space_4"
                            app:iconSize="16dp"
                            app:iconTint="@color/color_primary" />

                        <!-- Class Statistics -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClassStatistics"
                            style="@style/Widget.EduLens.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height_md"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:paddingHorizontal="@dimen/space_4"
                            android:text="@string/lecturer_action_stats"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_bar_chart"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/space_4"
                            app:iconSize="16dp"
                            app:iconTint="@color/color_primary" />
                    </LinearLayout>

                    <!-- Section: Announcements -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_20"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.EduLens.Subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/section_announcements"
                            android:textColor="@color/text_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCreateAnnouncement"
                            style="@style/Widget.EduLens.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:minHeight="32dp"
                            android:paddingHorizontal="@dimen/space_8"
                            android:paddingVertical="0dp"
                            android:text="@string/btn_create_announcement"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAnnouncements"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_notification_row" />

                    <TextView
                        android:id="@+id/tvEmptyAnnouncements"
                        style="@style/TextAppearance.EduLens.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="Chưa có thông báo nào trong lớp"
                        android:textColor="@color/text_muted"
                        android:visibility="gone" />

                    <!-- Section: Materials -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_20"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.EduLens.Subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/section_materials"
                            android:textColor="@color/text_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUploadMaterial"
                            style="@style/Widget.EduLens.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:minHeight="32dp"
                            android:paddingHorizontal="@dimen/space_8"
                            android:paddingVertical="0dp"
                            android:text="@string/btn_upload_material"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvMaterials"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_document_row" />

                    <TextView
                        android:id="@+id/tvEmptyMaterials"
                        style="@style/TextAppearance.EduLens.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="Chưa có tài liệu nào trong lớp"
                        android:textColor="@color/text_muted"
                        android:visibility="gone" />

                    <!-- Section: Assignments -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_20"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.EduLens.Subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/section_assignments"
                            android:textColor="@color/text_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCreateAssignment"
                            style="@style/Widget.EduLens.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:minHeight="32dp"
                            android:paddingHorizontal="@dimen/space_8"
                            android:paddingVertical="0dp"
                            android:text="@string/btn_create_assignment"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAssignments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_assignment_row" />

                    <TextView
                        android:id="@+id/tvEmptyAssignments"
                        style="@style/TextAppearance.EduLens.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="Chưa có bài tập nào trong lớp"
                        android:textColor="@color/text_muted"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
