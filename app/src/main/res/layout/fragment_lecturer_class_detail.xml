<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uc_bg_canvas"
    android:orientation="vertical">

    <include
        android:id="@+id/topAppBar"
        layout="@layout/view_top_app_bar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <!-- Bento Hero Container (Class Header + 3 Metrics) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_unified_bento_hero"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tvClassName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Thiết kế giao diện người dùng" />

                        <TextView
                            android:id="@+id/tvClassCodeSemester"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:textColor="#CCD0CF"
                            android:textSize="13sp"
                            tools:text="NT118.O21 · HK1 (2026-2027)" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvClassRoom"
                                style="@style/TextAppearance.EduLens.Caption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="#9BA8AB"
                                android:textSize="12sp"
                                tools:text="Phòng B5.12" />

                            <!-- Pill for Invite Code -->
                            <LinearLayout
                                android:id="@+id/btnCopyInviteCode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_unified_bento_stat_highlight"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="@dimen/space_12"
                                android:paddingVertical="@dimen/space_4">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_content_copy"
                                    app:tint="#C5BAC4" />

                                <TextView
                                    android:id="@+id/tvInviteCode"
                                    style="@style/TextAppearance.EduLens.Badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_4"
                                    android:textColor="#C5BAC4"
                                    tools:text="Mã: K7M-2QX" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 3 Metric Boxes Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <!-- Metric 1: Students -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/space_4"
                                android:layout_weight="1"
                                android:background="@drawable/bg_unified_bento_stat"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="10dp">

                                <TextView
                                    android:id="@+id/tvEnrolledCount"
                                    style="@style/TextAppearance.EduLens.Title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#FFFFFF"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    tools:text="45" />

                                <TextView
                                    style="@style/TextAppearance.EduLens.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:text="@string/metric_students"
                                    android:textColor="#9BA8AB"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Metric 2: Assignments -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/space_4"
                                android:layout_weight="1"
                                android:background="@drawable/bg_unified_bento_stat"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="10dp">

                                <TextView
                                    android:id="@+id/tvAssignmentCount"
                                    style="@style/TextAppearance.EduLens.Title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#FFFFFF"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    tools:text="4" />

                                <TextView
                                    style="@style/TextAppearance.EduLens.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:text="@string/metric_assignments"
                                    android:textColor="#9BA8AB"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Metric 3: Attendance -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_4"
                                android:layout_weight="1"
                                android:background="@drawable/bg_unified_bento_stat"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="10dp">

                                <TextView
                                    android:id="@+id/tvAttendanceRate"
                                    style="@style/TextAppearance.EduLens.Title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#C5BAC4"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    tools:text="92%" />

                                <TextView
                                    style="@style/TextAppearance.EduLens.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:text="@string/metric_attendance"
                                    android:textColor="#9BA8AB"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Quick Action Buttons Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:orientation="horizontal">

                        <!-- Manage Members -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManageMembers"
                            style="@style/Widget.EduLens.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height_md"
                            android:layout_marginEnd="@dimen/space_4"
                            android:layout_weight="1"
                            android:paddingHorizontal="@dimen/space_4"
                            android:text="@string/lecturer_action_members"
                            android:textColor="@color/uc_text_primary"
                            android:textSize="12sp"
                            app:backgroundTint="@color/uc_surface_elevated"
                            app:icon="@drawable/ic_group"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/space_4"
                            app:iconSize="16dp"
                            app:iconTint="@color/uc_text_primary"
                            app:strokeColor="@color/uc_border_card"
                            app:strokeWidth="1dp" />

                        <!-- Open QR Session -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenQrSession"
                            style="@style/Widget.EduLens.Button.Filled"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height_md"
                            android:layout_marginHorizontal="@dimen/space_4"
                            android:layout_weight="1.2"
                            android:paddingHorizontal="@dimen/space_4"
                            android:text="@string/lecturer_action_qr"
                            android:textColor="@color/uc_btn_primary_text"
                            android:textSize="12sp"
                            app:backgroundTint="@color/uc_btn_primary_bg"
                            app:icon="@drawable/ic_qr_scan"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/space_4"
                            app:iconSize="16dp"
                            app:iconTint="@color/uc_btn_primary_text" />

                        <!-- Class Statistics -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClassStatistics"
                            style="@style/Widget.EduLens.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height_md"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:paddingHorizontal="@dimen/space_4"
                            android:text="@string/lecturer_action_stats"
                            android:textColor="@color/uc_text_primary"
                            android:textSize="12sp"
                            app:backgroundTint="@color/uc_surface_elevated"
                            app:icon="@drawable/ic_bar_chart"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/space_4"
                            app:iconSize="16dp"
                            app:iconTint="@color/uc_text_primary"
                            app:strokeColor="@color/uc_border_card"
                            app:strokeWidth="1dp" />
                    </LinearLayout>

                    <!-- Section: Announcements -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_20"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.EduLens.Subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/section_announcements"
                            android:textColor="@color/text_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCreateAnnouncement"
                            style="@style/Widget.EduLens.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:minHeight="32dp"
                            android:paddingHorizontal="@dimen/space_8"
                            android:paddingVertical="0dp"
                            android:text="@string/btn_create_announcement"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAnnouncements"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_notification_row" />

                    <TextView
                        android:id="@+id/tvEmptyAnnouncements"
                        style="@style/TextAppearance.EduLens.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:background="@drawable/bg_unified_surface_card"
                        android:gravity="center"
                        android:padding="16dp"
                        android:text="Chưa có thông báo nào trong lớp"
                        android:textColor="@color/uc_text_secondary"
                        android:visibility="gone" />

                    <!-- Section: Materials -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_20"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.EduLens.Subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/section_materials"
                            android:textColor="@color/text_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUploadMaterial"
                            style="@style/Widget.EduLens.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:minHeight="32dp"
                            android:paddingHorizontal="@dimen/space_8"
                            android:paddingVertical="0dp"
                            android:text="@string/btn_upload_material"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvMaterials"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_document_row" />

                    <TextView
                        android:id="@+id/tvEmptyMaterials"
                        style="@style/TextAppearance.EduLens.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:background="@drawable/bg_unified_surface_card"
                        android:gravity="center"
                        android:padding="16dp"
                        android:text="Chưa có tài liệu nào trong lớp"
                        android:textColor="@color/uc_text_secondary"
                        android:visibility="gone" />

                    <!-- Section: Assignments -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_20"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.EduLens.Subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/section_assignments"
                            android:textColor="@color/text_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCreateAssignment"
                            style="@style/Widget.EduLens.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:minHeight="32dp"
                            android:paddingHorizontal="@dimen/space_8"
                            android:paddingVertical="0dp"
                            android:text="@string/btn_create_assignment"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAssignments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_assignment_row" />

                    <TextView
                        android:id="@+id/tvEmptyAssignments"
                        style="@style/TextAppearance.EduLens.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:background="@drawable/bg_unified_surface_card"
                        android:gravity="center"
                        android:padding="16dp"
                        android:text="Chưa có bài tập nào trong lớp"
                        android:textColor="@color/uc_text_secondary"
                        android:visibility="gone" />

                    <!-- Section: Class Schedules -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_20"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.EduLens.Subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/section_class_schedules"
                            android:textColor="@color/text_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddSchedule"
                            style="@style/Widget.EduLens.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:minHeight="32dp"
                            android:paddingHorizontal="@dimen/space_8"
                            android:paddingVertical="0dp"
                            android:text="@string/btn_add_schedule"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvClassSchedules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_semester_schedule" />

                    <TextView
                        android:id="@+id/tvEmptyClassSchedules"
                        style="@style/TextAppearance.EduLens.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:background="@drawable/bg_unified_surface_card"
                        android:gravity="center"
                        android:padding="16dp"
                        android:text="@string/empty_class_schedules"
                        android:textColor="@color/uc_text_secondary"
                        android:visibility="gone" />

                    <!-- Section: Schedule Exceptions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_20"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.EduLens.Subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/section_class_exceptions"
                            android:textColor="@color/text_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCreateScheduleException"
                            style="@style/Widget.EduLens.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:minHeight="32dp"
                            android:paddingHorizontal="@dimen/space_8"
                            android:paddingVertical="0dp"
                            android:text="@string/btn_create_schedule_exception"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvClassExceptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_schedule_exception" />

                    <TextView
                        android:id="@+id/tvEmptyClassExceptions"
                        style="@style/TextAppearance.EduLens.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:background="@drawable/bg_unified_surface_card"
                        android:gravity="center"
                        android:padding="16dp"
                        android:text="@string/empty_class_exceptions"
                        android:textColor="@color/uc_text_secondary"
                        android:visibility="gone" />

                    <!-- Class Lifecycle Action Button (Delete / Archive) -->
                    <LinearLayout
                        android:id="@+id/rowClassLifecycleAction"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="32dp"
                        android:background="@drawable/bg_unified_logout_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivClassLifecycleIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_delete"
                            app:tint="@color/color_error" />

                        <TextView
                            android:id="@+id/tvClassLifecycleText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/btn_delete_class_permanently"
                            android:textColor="@color/color_error"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
