<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowSubmissionRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_8"
    android:background="@drawable/bg_surface_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/space_12">

    <!-- Avatar Initial Circle -->
    <FrameLayout
        android:id="@+id/flAvatarBadge"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_aura">

        <TextView
            android:id="@+id/tvAvatarInitial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/color_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="NA" />
    </FrameLayout>

    <!-- Student & Submission Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_8"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStudentName"
            style="@style/TextAppearance.EduLens.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            tools:text="Nguyễn Văn An" />

        <TextView
            android:id="@+id/tvStudentCode"
            style="@style/TextAppearance.EduLens.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            tools:text="MSSV: 21520001" />

        <TextView
            android:id="@+id/tvSubmittedAt"
            style="@style/TextAppearance.EduLens.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_muted"
            tools:text="Nộp lúc: 20:30 · 28/10/2026" />

        <TextView
            android:id="@+id/tvFileInfo"
            style="@style/TextAppearance.EduLens.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:drawablePadding="@dimen/space_4"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/color_primary"
            app:drawableStartCompat="@drawable/ic_file_document"
            app:drawableTint="@color/color_primary"
            tools:text="bai_tap_1.pdf" />
    </LinearLayout>

    <!-- Status Badge Column -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_green"
            android:paddingHorizontal="@dimen/space_8"
            android:paddingVertical="@dimen/space_4"
            android:textColor="@color/color_success"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Đã chấm: 9.0" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="@dimen/space_4"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_muted" />
    </LinearLayout>

</LinearLayout>
