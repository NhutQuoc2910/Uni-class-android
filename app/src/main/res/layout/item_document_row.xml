<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowDocumentRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/list_item_height"
    android:layout_marginBottom="@dimen/space_8"
    android:background="@drawable/bg_unified_surface_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <FrameLayout
        android:id="@+id/flFileTypeBadge"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_badge_pill">

        <TextView
            android:id="@+id/tvFileTypeExt"
            style="@style/TextAppearance.EduLens.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="PDF"
            android:textColor="@color/color_error" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDocumentTitle"
            style="@style/TextAppearance.EduLens.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/docs_and_homework"
            android:textColor="@color/uc_text_primary" />

        <TextView
            android:id="@+id/tvDocumentMeta"
            style="@style/TextAppearance.EduLens.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="2.4 MB · PDF"
            android:textColor="@color/uc_text_secondary" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivDownloadStatus"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_download"
        app:tint="@color/color_primary" />

    <ImageButton
        android:id="@+id/btnDeleteDoc"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="@dimen/space_8"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_delete"
        android:visibility="gone"
        app:tint="@color/color_error" />
</LinearLayout>
