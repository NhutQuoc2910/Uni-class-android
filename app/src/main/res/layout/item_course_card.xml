<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCourseRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/uc_surface_card"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/uc_border_card"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Section: Avatar Circle + Title + Red Dot -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Circular Prefix Badge (Left) -->
            <FrameLayout
                android:id="@+id/flPrefixBadge"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/bg_unified_top_logo">

                <TextView
                    android:id="@+id/tvCoursePrefix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/p2_lavender"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="SE" />
            </FrameLayout>

            <!-- Red Unread Dot (Right Top) -->
            <View
                android:id="@+id/viewUnreadDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_unread_dot"
                android:visibility="gone" />

            <!-- Title & Code Details (Middle) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_toEndOf="@id/flPrefixBadge"
                android:layout_toStartOf="@id/viewUnreadDot"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCourseName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/uc_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Nhập môn Công nghệ phần mềm" />

                <TextView
                    android:id="@+id/tvCodeAndSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/uc_text_secondary"
                    android:textSize="12sp"
                    tools:text="SE104.021 · Thứ 3, tiết 1-3" />

            </LinearLayout>

        </RelativeLayout>

        <!-- Lecturer Row -->
        <TextView
            android:id="@+id/tvLecturerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/uc_text_secondary"
            android:textSize="13sp"
            tools:text="GV: TS. Lê Hoàng Nam" />

        <!-- Status & Semester Badges Row -->
        <LinearLayout
            android:id="@+id/layoutBadgesRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvStatusBadge"
                style="@style/TextAppearance.EduLens.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/color_success"
                android:visibility="gone"
                tools:text="Đang mở" />

            <TextView
                android:id="@+id/tvSemesterBadge"
                style="@style/TextAppearance.EduLens.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/uc_text_secondary"
                android:visibility="gone"
                tools:text="HK1 2024-2025" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
