<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_surface_card"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_20"
    android:paddingTop="@dimen/space_12"
    android:paddingBottom="@dimen/space_24">

    <!-- Drag handle -->
    <View
        android:id="@+id/viewDragHandle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_drag_handle" />

    <!-- Sheet Title -->
    <TextView
        android:id="@+id/tvAnnouncementTitleHeader"
        style="@style/TextAppearance.EduLens.Headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/announcement_new_title" />

    <!-- Input Title -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAnnouncementTitle"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:hint="@string/label_announcement_title"
        app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
        app:boxCornerRadiusBottomStart="@dimen/radius_sm"
        app:boxCornerRadiusTopEnd="@dimen/radius_sm"
        app:boxCornerRadiusTopStart="@dimen/radius_sm"
        app:boxStrokeColor="@color/color_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAnnouncementTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_announcement_title"
            android:inputType="textCapSentences"
            android:maxLines="2"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Input Content -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAnnouncementContent"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:hint="@string/label_announcement_content"
        app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
        app:boxCornerRadiusBottomStart="@dimen/radius_sm"
        app:boxCornerRadiusTopEnd="@dimen/radius_sm"
        app:boxCornerRadiusTopStart="@dimen/radius_sm"
        app:boxStrokeColor="@color/color_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAnnouncementContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/hint_announcement_content"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Urgent Announcement Switch Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:background="@drawable/bg_surface_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_12">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.EduLens.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_urgent_announcement"
                android:textColor="@color/text_primary" />

            <TextView
                style="@style/TextAppearance.EduLens.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/desc_urgent_announcement"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchUrgent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/pbSubmitting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_12"
        android:visibility="gone" />

    <!-- Submit Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitAnnouncement"
        style="@style/Widget.EduLens.Button.Filled"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_lg"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/btn_post_announcement"
        app:icon="@drawable/ic_notification"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/space_8" />
</LinearLayout>
