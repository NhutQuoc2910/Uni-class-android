<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowAssignmentRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/list_item_height"
    android:layout_marginBottom="@dimen/space_8"
    android:background="@drawable/bg_surface_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_12">

    <ImageView
        android:id="@+id/ivAssignmentIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle_aura"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_assignment"
        app:tint="@color/color_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAssignmentTitle"
            style="@style/TextAppearance.EduLens.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/assignment_title_1" />

        <TextView
            android:id="@+id/tvAssignmentCourseOrDue"
            style="@style/TextAppearance.EduLens.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/assignment_desc_1" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDeadlineBadge"
        style="@style/TextAppearance.EduLens.Badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_pill"
        android:paddingHorizontal="@dimen/space_12"
        android:paddingVertical="4dp"
        android:text="@string/status_due_soon"
        android:textColor="@color/color_warning" />
</LinearLayout>
