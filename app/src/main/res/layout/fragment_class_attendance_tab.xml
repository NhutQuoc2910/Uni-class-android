<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uc_bg_canvas">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- Card tóm tắt điểm danh (Unified Surface Card để không lặp Bento Hero với Header của Class Detail) -->
            <LinearLayout
                android:id="@+id/cardAttendanceSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_16"
                android:background="@drawable/bg_unified_surface_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Row: "CHUYÊN CẦN", tvPresentFraction, and highlighted badge tvAttendanceRateBadge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAttendanceLabel"
                        style="@style/TextAppearance.EduLens.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.04"
                        android:text="@string/attendance_diligence"
                        android:textColor="@color/uc_text_muted"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPresentFraction"
                        style="@style/TextAppearance.EduLens.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:textColor="@color/uc_text_primary"
                        tools:text="5/5 buổi" />

                    <TextView
                        android:id="@+id/tvAttendanceRateBadge"
                        style="@style/TextAppearance.EduLens.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_unified_lavender_pill"
                        android:paddingHorizontal="@dimen/space_12"
                        android:paddingVertical="@dimen/space_4"
                        android:textColor="@color/p2_ink"
                        tools:text="100%" />
                </LinearLayout>

                <!-- Linear ProgressBar -->
                <ProgressBar
                    android:id="@+id/pbAttendanceProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="@dimen/space_12"
                    android:max="100"
                    android:progress="100"
                    android:progressBackgroundTint="@color/uc_surface_elevated"
                    android:progressTint="@color/color_primary" />

                <!-- TextView tvAttendanceNote -->
                <TextView
                    android:id="@+id/tvAttendanceNote"
                    style="@style/TextAppearance.EduLens.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/attendance_note"
                    android:textColor="@color/uc_text_secondary" />

                <!-- Link "Xem lịch sử chi tiết ›" -->
                <TextView
                    android:id="@+id/btnViewFullHistory"
                    style="@style/TextAppearance.EduLens.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/space_8"
                    android:paddingVertical="@dimen/space_4"
                    android:text="Xem lịch sử chi tiết ›"
                    android:textColor="@color/color_primary"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Button "Điểm danh ngay bằng mã QR" (Adaptive Primary CTA token) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanAttendance"
                style="@style/Widget.EduLens.Button.Filled"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="@dimen/space_16"
                android:text="@string/btn_scan_attendance"
                app:icon="@drawable/ic_qr_scan"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/space_8"
                app:iconTint="@color/uc_btn_primary_text" />

            <!-- Header "LỊCH SỬ TỪNG BUỔI" -->
            <TextView
                android:id="@+id/tvSectionHistory"
                style="@style/TextAppearance.EduLens.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/section_attendance_history"
                android:textColor="@color/uc_text_primary" />

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAttendanceRecords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_attendance_row" />

            <!-- Empty Attendance -->
            <TextView
                android:id="@+id/tvEmptyAttendance"
                style="@style/TextAppearance.EduLens.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/space_24"
                android:text="@string/empty_attendance"
                android:textColor="@color/uc_text_muted"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
