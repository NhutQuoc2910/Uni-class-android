<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardScheduleExceptionRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pill"
            android:gravity="center"
            android:minWidth="92dp"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvExceptionTypeBadge"
                style="@style/TextAppearance.EduLens.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textColor="#DC2626"
                android:textStyle="bold"
                tools:text="Báo nghỉ" />

            <TextView
                android:id="@+id/tvExceptionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAlignment="center"
                android:textColor="#64748B"
                android:textSize="11sp"
                tools:text="Đã công bố" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCourseTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="NT118.Q11 - Phát triển ứng dụng di động" />

            <TextView
                android:id="@+id/tvExceptionDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Ngày gốc: 20/10/2026" />

            <TextView
                android:id="@+id/tvExceptionTimeRoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#64748B"
                android:textSize="12sp"
                tools:text="07:30 - 11:30 · Phòng B3.10" />

            <TextView
                android:id="@+id/tvExceptionReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#64748B"
                android:textSize="12sp"
                tools:text="Lý do: Giảng viên đi công tác" />

            <LinearLayout
                android:id="@+id/llLecturerActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRevokeException"
                    style="@style/Widget.EduLens.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minHeight="36dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:text="@string/btn_revoke_exception"
                    android:textColor="#DC2626"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:strokeColor="#DC2626" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPublishException"
                    style="@style/Widget.EduLens.Button.Filled"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:minHeight="36dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:text="@string/btn_publish_exception"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
