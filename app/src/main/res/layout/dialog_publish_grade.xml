<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_24">

    <TextView
        android:id="@+id/tvDialogTitle"
        style="@style/TextAppearance.EduLens.Headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_publish_grade_title"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvDialogSubtitle"
        style="@style/TextAppearance.EduLens.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="Chọn phạm vi công bố điểm số để sinh viên có thể xem kết quả bài nộp của mình."
        android:textColor="@color/text_secondary" />

    <RadioGroup
        android:id="@+id/rgPublishScope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbPublishCurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/rb_publish_current"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            app:buttonTint="@color/color_primary" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbPublishAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/rb_publish_all"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            app:buttonTint="@color/color_primary" />
    </RadioGroup>

</LinearLayout>
